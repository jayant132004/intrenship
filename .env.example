# ==========================================
# ARA-1 Autonomous Financial Research Agent
# Environment Configuration Template
# ==========================================

# LLM Providers
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEFAULT_LLM_MODEL=gpt-4o-mini
REASONING_LLM_MODEL=gpt-4o

# Data Sources & Search APIs
SEC_EDGAR_USER_AGENT=QuantumEdgeResearch admin@quantumedge.ai
TAVILY_API_KEY=your_tavily_api_key_here
FMP_API_KEY=your_financial_modeling_prep_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
NEWS_API_KEY=your_news_api_key_here

# Vector Database & Memory Paths
CHROMA_PERSIST_DIR=./data/chromadb
EPISODIC_MEMORY_PATH=./data/episodic_memory.json
EMBEDDING_MODEL=text-embedding-3-small

# Agent Execution & Safety Settings
MAX_ITERATIONS=15
CIRCUIT_BREAKER_THRESHOLD=3
SIMULATE_TOOL_FAILURE_RATE=0.0
LOG_LEVEL=INFO
